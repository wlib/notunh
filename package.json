{
  "private": true,
  "name": "notunh",
  "type": "module",
  "scripts": {
    "icons": "node scripts/icons.mts",
    "fixtures": "node tests/fixtures/make.mts",
    "predev": "node scripts/inputs.mts",
    "dev": "vite",
    "prebuild": "node scripts/inputs.mts && npm run typecheck && npm test",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "test:browser": "playwright test",
    "model": "node scripts/map/model.mts",
    "db:generate": "drizzle-kit generate --config drizzle.config.mts",
    "db:migrate": "wrangler d1 migrations apply notunh --remote",
    "db:migrate:local": "wrangler d1 migrations apply notunh --local",
    "worker": "node scripts/inputs.mts && npm run db:migrate:local && wrangler dev --test-scheduled",
    "storage": "node scripts/worker.mts storage",
    "predeploy": "npm run db:migrate",
    "deploy": "wrangler deploy",
    "fresh": "node scripts/data.mts"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@standard-schema/spec": "^1.1.0",
    "bruh": "^2.0.0-beta.5",
    "cheap-ruler": "^4.1.1",
    "drizzle-orm": "^0.45.3",
    "flatbush": "^4.6.2",
    "hono": "^4.13.13",
    "maplibre-gl": "^6.11.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@mdn/browser-compat-data": "^8.1.4",
    "@osmix/pbf": "^0.0.10",
    "@playwright/test": "^1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "browserslist": "^4.29.3",
    "browserslist-to-esbuild": "^2.1.1",
    "colorjs.io": "^0.7.1",
    "csv-parse": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "lightningcss": "^1.33.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-bruh": "^2.0.0-beta.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "browserslist": [
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "last 2 chrome versions",
    "last 2 and_chr versions",
    "last 2 firefox versions",
    "last 2 edge versions"
  ]
}

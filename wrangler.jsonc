{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notunh",
  "main": "worker/index.mts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "notunh.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API, the laundry rooms' own addresses, and the pins' pages invoke the Worker. Every other page and
    // asset, the laundry and pin pages themselves included, is served as a static asset, which is free and unlimited
    "run_worker_first": ["/api/*", "/laundry/*", "!/laundry/", "/p/*", "!/p/"]
  },
  "triggers": {
    // Work is split across triggers and minutes to keep each invocation small. worker/ matches these strings
    // exactly, so change them there too
    "crons": [
      // Buses, polled six times a minute, 10 s apart
      "* * * * *",
      // Umo's predictions
      "*/5 * * * *",
      // Laundry machines: a quarter of the rooms in each minute but every fifth, so each room is polled every 5
      // minutes, and every 15 from 1 to 6 AM
      "1-4,6-9,11-14,16-19,21-24,26-29,31-34,36-39,41-44,46-49,51-54,56-59 * * * *",
      // Nightly: prune, then start the workflows that archive the samples and make the inputs, which rebuild the site
      // (4:17 AM in Durham under EDT, 3:17 under EST)
      "17 8 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notunh",
      "database_id": "7825ba46-2d35-41d7-8e01-5c41f3f1af3c",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Each device's reminders, in a SQLite-backed Durable Object of its own (worker/reminders.mts, docs/reminders.md)
  "durable_objects": {
    "bindings": [{ "name": "REMINDERS", "class_name": "Reminders" }]
  },
  "migrations": [{ "tag": "reminders-1", "new_sqlite_classes": ["Reminders"] }],
  // How many reminders one address may set a minute (worker/api.mts): a phone sets a few, and a client minting device
  // ids would otherwise make an object of each (https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/)
  "ratelimits": [{ "name": "RATE_LIMIT", "namespace_id": "1", "simple": { "limit": 30, "period": 60 } }],
  // Verification codes to UNH addresses, through Cloudflare Email Service (worker/mail.mts, docs/social.md), only from
  // the one sender, on notunh.app once it's onboarded. `wrangler dev` simulates it, logging what it would send
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["codes@notunh.app"] }],
  "vars": {
    // Who push services can reach about our pushes (worker/push.mts)
    "VAPID_SUBJECT": "https://notunh.app",
    // Days the nightly prune keeps (worker/rows.mts, docs/storage.md):
    // - RETAIN_DAYS: laundry's transitions and polls
    // - RETAIN_ARCHIVED_DAYS: samples once the observations archive has their day, since learning reads older days
    //   from it. A day the archive doesn't have yet is never pruned
    // - RETAIN_VISIT_DAYS: the visits derived from each day, which a refit with the same extractor reuses. With the
    //   models' 4-week half-life, a day 180 days back weighs 1 % of today's
    // - RETAIN_STATISTICS_DAYS: each day's statistics and evaluation, about 25 KB gzipped, so a week can be compared
    //   with the same week a year before
    "RETAIN_DAYS": 60,
    "RETAIN_ARCHIVED_DAYS": 14,
    "RETAIN_VISIT_DAYS": 180,
    "RETAIN_STATISTICS_DAYS": 400,
    // The social features switched off (worker/social.mts, docs/social.md), by name: any of pins, link, email, sync
    "SOCIAL_OFF": "",
    // Who verification codes come from (worker/mail.mts), one of the binding's allowed senders
    "MAIL_FROM": "codes@notunh.app"
  },
  // Secrets, set once with `wrangler secret put` (locally, in .dev.vars):
  // - BUILD_TOKEN: what the workflows read and write rows and models with
  // - GITHUB_TOKEN: for the nightly run to start the Observations and Inputs workflows, and Map data on Mondays
  // - VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY: what reminders are pushed with, made once by
  //   `node scripts/secrets.mts vapid`. Without them, reminders aren't offered
  "observability": { "enabled": true },
  // Previews (`npx wrangler preview`) get none of the above: no route, no crons, and their own database, which every
  // branch's Preview shares, migrated before a Preview is made. They have no secrets, so nothing reaches production
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "notunh-preview",
        "database_id": "b774a3e5-ff9c-4ce1-b1d0-4c977481681d",
        "migrations_dir": "worker/migrations"
      }
    ],
    "vars": {
      "RETAIN_DAYS": 60,
      "RETAIN_ARCHIVED_DAYS": 14,
      "RETAIN_VISIT_DAYS": 180,
      "RETAIN_STATISTICS_DAYS": 400
    }
  }
}

{
  "include": ["./src/", "./scripts/", "./tests/", "./*.html.tsx", "./*/*.html.tsx"],
  // The Worker and its tests have Cloudflare's runtime types instead of the DOM's, in worker/tsconfig.json
  "exclude": ["./tests/worker/"],

  "compilerOptions": {
    "types": ["vite/client", "node", "geojson"],

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "jsx": "react-jsx",

    "strict": true,
    "isolatedModules": true,
    "noEmit": true,

    "skipLibCheck": true
  }
}

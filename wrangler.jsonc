{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notunh",
  "main": "worker/index.mts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "notunh.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API and the laundry rooms' own addresses invoke the Worker. Every other page and asset, the laundry
    // page itself included, is served as a static asset, which is free and unlimited
    "run_worker_first": ["/api/*", "/laundry/*", "!/laundry/"]
  },
  "triggers": {
    // The free plan allows five cron triggers per account, and each invocation gets its own 10 ms of CPU, so the
    // work is split across triggers and minutes. worker/ matches these strings exactly, so change them there too
    "crons": [
      // Buses, polled six times a minute, 10 s apart
      "* * * * *",
      // Umo's predictions
      "*/5 * * * *",
      // Laundry machines: a quarter of the rooms in each minute but every fifth, so each room is polled every 5
      // minutes, and every 15 from 1 to 6 AM
      "1-4,6-9,11-14,16-19,21-24,26-29,31-34,36-39,41-44,46-49,51-54,56-59 * * * *",
      // Nightly: prune, then rebuild the site with a fresh timetable and menus (4:17 AM in Durham under EDT, 3:17
      // under EST)
      "17 8 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notunh",
      "database_id": "7825ba46-2d35-41d7-8e01-5c41f3f1af3c",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    // Days the nightly prune keeps (worker/rows.mts, docs/storage.md):
    // - RETAIN_DAYS: samples the observations archive doesn't have yet, and laundry transitions and polls
    // - RETAIN_ARCHIVED_DAYS: samples once the archive has their day, since builds and refits read older days from it
    // - RETAIN_VISIT_DAYS: visits, the one table that would outgrow D1's free 500 MB within a year. With the models'
    //   4-week half-life, a day 180 days back weighs 1 % of today's
    // - RETAIN_SUMMARY_DAYS: daily location model summaries, about 90 KB each, so a week can be compared with the
    //   same week a year before
    "RETAIN_DAYS": 60,
    "RETAIN_ARCHIVED_DAYS": 14,
    "RETAIN_VISIT_DAYS": 180,
    "RETAIN_SUMMARY_DAYS": 400
  },
  // Secrets, set once with `wrangler secret put` (locally, in .dev.vars):
  // - DEPLOY_HOOK: the Workers Builds hook the nightly run calls to rebuild the site
  // - BUILD_TOKEN: what the build reads and writes rows and models with
  // - GITHUB_TOKEN, optional: for the nightly run to start the Observations workflow every night and the Map data
  //   workflow on Mondays, since GitHub pauses schedules after 60 days without a commit
  "observability": { "enabled": true }
}
